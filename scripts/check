#!/usr/bin/env python3
"""Repo validation gate for factory-agents.

Runs, in order:
  1. `python3 -m py_compile` on every executable Python script in scripts/.
  2. A `--help` smoke test of every executable in scripts/ (ensures the CLI
     surface is wired up and importable).
  3. scripts/factory-validate-skills (frontmatter lint + git diff --check +
     cross-reference scan).
  4. scripts/factory-validate-config (structural + consistency validation of
     foreman/config.json and the four track configs; a pristine template
     passes with warnings, a partially-configured repo fails).

Iterates over whatever executables are actually present in scripts/ (glob), so
it works both in a single agent's worktree and after integration — it never
hard-requires sibling scripts that may be absent. Exits nonzero if anything
fails.

No third-party dependencies; Python 3 stdlib only.
"""

import argparse
import os
import subprocess
import sys

SCRIPTS_DIR = os.path.dirname(os.path.abspath(__file__))
SELF = os.path.basename(__file__)


def executables():
    """Executable regular files in scripts/, excluding this gate itself."""
    out = []
    for entry in sorted(os.listdir(SCRIPTS_DIR)):
        if entry == SELF:
            continue
        full = os.path.join(SCRIPTS_DIR, entry)
        if os.path.isfile(full) and os.access(full, os.X_OK):
            out.append(full)
    return out


def is_python(path):
    try:
        with open(path, "rb") as fh:
            first = fh.readline()
    except OSError:
        return False
    return b"python" in first


def run(label, cmd):
    print(f"==> {label}")
    result = subprocess.run(cmd)
    if result.returncode != 0:
        print(f"FAIL  {label} (exit {result.returncode})")
        return False
    return True


def main():
    argparse.ArgumentParser(
        prog="check",
        description="Validate factory-agents: py_compile, --help smoke tests, "
        "and factory-validate-skills.",
    ).parse_args()

    scripts = executables()
    py_scripts = [s for s in scripts if is_python(s)]
    ok = True

    if py_scripts:
        ok &= run(
            "py_compile",
            [sys.executable, "-m", "py_compile", *py_scripts],
        )

    for script in scripts:
        name = os.path.basename(script)
        ok &= run(f"{name} --help", [script, "--help"])

    validate = os.path.join(SCRIPTS_DIR, "factory-validate-skills")
    if os.path.isfile(validate) and os.access(validate, os.X_OK):
        ok &= run("factory-validate-skills", [validate])
    else:
        print("FAIL  factory-validate-skills not found in scripts/")
        ok = False

    validate_config = os.path.join(SCRIPTS_DIR, "factory-validate-config")
    if os.path.isfile(validate_config) and os.access(validate_config, os.X_OK):
        ok &= run("factory-validate-config", [validate_config])
    else:
        print("FAIL  factory-validate-config not found in scripts/")
        ok = False

    print("\nPASS: all checks succeeded" if ok else "\nFAILED: see errors above")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
