#!/usr/bin/env python3
"""forge -- provider-agnostic code-forge CLI for the factory loop.

This is the code-forge abstraction seam. It accepts a `--provider` flag (default
`github`) and a `FACTORY_FORGE_PROVIDER` environment variable, then delegates all
subcommands to the configured provider script. The default provider is GitHub,
which keeps the existing factory behavior unchanged.

Currently supported providers:
  github            -> scripts/github            (default; real GitHub backend)
  mock-code-forge   -> scripts/mock-code-forge   (in-memory mock backend, evals only)

Subcommands are passed through unchanged to the provider script, so the GitHub
path's commands, flags, output shapes, and behavior remain identical. The
`mock-code-forge` provider mirrors the same command surface but keeps data in a
local store and always succeeds; it is intended for the eval harness
(`scripts/factory-eval`), not for real work.

No third-party dependencies; Python 3 stdlib only.
"""
import argparse
import os
import subprocess
import sys

DEFAULT_PROVIDER = "github"

_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
_PROVIDER_SCRIPTS = {
    "github": os.path.join(_REPO_ROOT, "scripts", "github"),
    "mock-code-forge": os.path.join(_REPO_ROOT, "scripts", "mock-code-forge"),
}


def die(msg, code=1):
    sys.stderr.write(msg.rstrip() + "\n")
    sys.exit(code)


def provider_script(provider):
    script = _PROVIDER_SCRIPTS.get(provider)
    if script is None:
        die(f"unknown forge provider: {provider!r}")
    if not os.path.isfile(script) or not os.access(script, os.X_OK):
        die(f"provider script not found or not executable: {script}")
    return script


def build_parser():
    parser = argparse.ArgumentParser(
        prog="forge",
        description=(
            "Provider-agnostic code-forge CLI for the factory loop. "
            "Delegates subcommands to the configured provider script."
        ),
    )
    parser.add_argument(
        "--provider",
        default=os.environ.get("FACTORY_FORGE_PROVIDER", DEFAULT_PROVIDER),
        help=(
            "Forge provider to use. Defaults to the FACTORY_FORGE_PROVIDER "
            "environment variable, or 'github' if unset."
        ),
    )
    parser.add_argument(
        "remainder",
        nargs=argparse.REMAINDER,
        help="Subcommand and arguments to pass through to the provider script.",
    )
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    if not args.remainder:
        die("forge: no subcommand given")

    script = provider_script(args.provider)
    try:
        result = subprocess.run([script, *args.remainder])
    except OSError as e:
        die(f"failed to run provider {args.provider!r}: {e}")
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
