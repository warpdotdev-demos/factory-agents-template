#!/usr/bin/env python3
"""factory-init -- bootstrap the factory's config files for a new adopter.

One deterministic entrypoint that writes the five config files a fresh copy of
this template needs before its first run:

  foreman/config.json          the shared, run-wide config (tracker block +
                               target repos + self references)
  triage/config.json           per-track dispatch config (repos.self updated;
  spec/config.json             the track's entrypoint_skill and model are
  implementation/config.json   preserved when the file already exists)
  code-review/config.json

It also seeds scripts/reviewer_overrides.json with an empty skeleton when the
file does not exist yet (an existing file is never touched).

Two ways to supply values:
  * FLAGS (non-interactive; suitable for automation) -- see --help.
  * INTERACTIVE prompts -- run with --interactive (or with no value flags on a
    TTY) and every value is prompted for with a sensible default.

Multi-project / many-repo setups: a Jira project usually owns only a SUBSET of
the repos, so declare that mapping and routing stays scoped (a ticket in PAY
can only reach payments repos). Three ways to express it:
  * --project-repos KEY=org/repo1,org/repo2 (repeatable) alongside --project;
  * --projects-json with the whole tracker.project_routing block (inline JSON
    or @file), which also carries per-project status_map / story_points_field /
    issue_type / spec_approval_required / environment_id overrides;
  * the interactive prompts, which ask which repos each project owns whenever
    more than one project or repo exists.
At that scale the config is usually generated from an existing source of truth
(a service catalog, CODEOWNERS, a repo manifest) -- use --projects-json plus
--target-repos-json for that, and --merge to onboard one more project/repo into
an already-configured factory.

Jira autodiscovery (optional, on by default): when $JIRA_BASE_URL,
$JIRA_EMAIL, and $JIRA_API_TOKEN are exported, the script calls the Jira Cloud
REST API to
  * list the REAL workflow status names for EVERY routed project
    (GET /rest/api/3/project/<KEY>/statuses) and validate every status_map
    value against them (warning per project on mismatches -- Jira status
    setting is transition-based and silently fails later if the name is wrong;
    a project whose workflow differs wants a per-project status_map override),
    and
  * auto-detect the story-points custom field id
    (GET /rest/api/3/field, matching "story point" in the field name).
Discovery soft-fails: any network/auth error degrades to a stderr warning and
manual values. Pass --no-discover to skip it entirely.

Safety: an existing foreman/config.json that still contains REPLACE_ME
placeholders (pristine template state) is overwritten freely; one that was
already customized requires --force (replace it) or --merge (add the supplied
projects/repos, keeping every other existing value).
reviewer_overrides.json is never overwritten. --dry-run prints the resolved
configs without writing anything.

Emits a JSON summary (written/skipped files + warnings) to stdout; fails loud
(nonzero exit + stderr) on invalid input.

No third-party dependencies; Python 3 stdlib only.
"""

import argparse
import base64
import copy
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
DEFAULT_REPO_ROOT = os.path.dirname(SCRIPT_DIR)

TRACKS = ("triage", "spec", "implementation", "code-review")
# Default entry skill per track, used only when a track config is missing.
DEFAULT_ENTRYPOINT_SKILLS = {
    "triage": "factory-triage",
    "spec": "factory-spec",
    "implementation": "factory-implement",
    "code-review": "factory-review",
}
DEFAULT_MODEL = "auto"
PLACEHOLDER = "REPLACE_ME"

FACTORY_STATES = ("Triage", "Todo", "In Progress", "In Review", "Done", "Canceled")
# A common out-of-the-box Jira Software workflow; adopters remap per project.
DEFAULT_STATUS_MAP = {
    "Triage": "To Do",
    "Todo": "To Do",
    "In Progress": "In Progress",
    "In Review": "In Review",
    "Done": "Done",
    "Canceled": "Done",
}
# The most common story-points field id on Jira Cloud sites; used only when
# discovery is unavailable and no explicit value was given.
COMMON_STORY_POINTS_FIELD = "customfield_10016"

TARGET_REPO_REQUIRED_FIELDS = (
    "description",
    "base_branch",
    "validate_command",
    "test_guidance",
)
TARGET_REPO_OPTIONAL_FIELDS = (
    "app_start_command",
    "app_url",
    "environment_id",
    "runner_id",
)
# Keys allowed on the object form of a tracker.project_routing value.
PROJECT_REQUIRED_FIELDS = ("description",)
PROJECT_OPTIONAL_FIELDS = (
    "repos",
    "default_repo",
    "status_map",
    "story_points_field",
    "issue_type",
    "spec_approval_required",
    "environment_id",
    "runner_id",
)

REVIEWER_OVERRIDES_SKELETON = {
    "_comment": (
        "Identity map joining one person across Slack, Jira, and GitHub. "
        "'overrides' maps a Jira accountId (or an email) to a GitHub reviewer "
        "handle (used by scripts/factory-resolve-reviewer). 'slack_users' maps "
        "a Slack user ID to the same person's display name, email, Jira "
        "accountId, and GitHub handle (used by the foreman to convert <@USERID> "
        "tokens into real Jira mentions). Find a Jira accountId with "
        "`scripts/tracker find-user \"<name-or-email>\"`. See SETUP.md."
    ),
    "overrides": {},
    "slack_users": {},
}


def die(msg, code=1):
    sys.stderr.write("factory-init: " + msg.rstrip() + "\n")
    sys.exit(code)


def warn(msg, warnings=None):
    sys.stderr.write("factory-init: warning: " + msg.rstrip() + "\n")
    if warnings is not None:
        warnings.append(msg)


# ---------------------------------------------------------------------------
# Jira autodiscovery (optional; soft-fails to manual values)
# ---------------------------------------------------------------------------

def _jira_env():
    """The (base_url, email, token) triple, or None when any part is unset."""
    base = os.environ.get("JIRA_BASE_URL", "").strip().rstrip("/")
    email = os.environ.get("JIRA_EMAIL", "").strip()
    token = os.environ.get("JIRA_API_TOKEN", "")
    if not (base and email and token):
        return None
    return base, email, token


def _jira_get(env, path):
    """GET a Jira Cloud REST v3 path; returns parsed JSON or raises."""
    base, email, token = env
    url = base + "/rest/api/3/" + path.lstrip("/")
    auth = base64.b64encode(f"{email}:{token}".encode("utf-8")).decode("ascii")
    req = urllib.request.Request(
        url,
        headers={"Authorization": "Basic " + auth, "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode("utf-8"))


def discover_statuses(env, project_key, warnings):
    """The set of real status names for a project, or None when unavailable."""
    try:
        data = _jira_get(env, f"project/{urllib.parse.quote(project_key)}/statuses")
    except Exception as e:  # noqa: BLE001 - soft-fail by design
        warn(f"could not list statuses for project {project_key!r}: {e}", warnings)
        return None
    names = set()
    if isinstance(data, list):
        for issue_type in data:
            for status in issue_type.get("statuses", []) or []:
                name = status.get("name")
                if name:
                    names.add(name)
    return names or None


def discover_story_points_field(env, warnings):
    """The story-points custom field id, or None when unavailable/ambiguous."""
    try:
        fields = _jira_get(env, "field")
    except Exception as e:  # noqa: BLE001 - soft-fail by design
        warn(f"could not list Jira fields: {e}", warnings)
        return None
    matches = [
        f for f in fields
        if isinstance(f, dict) and "story point" in (f.get("name") or "").lower()
    ]
    if not matches:
        warn("no Jira field with 'story point' in its name was found", warnings)
        return None
    # Prefer the classic "Story Points" / "Story point estimate" names.
    matches.sort(key=lambda f: len(f.get("name") or ""))
    chosen = matches[0]
    if len(matches) > 1:
        others = ", ".join(f"{f['id']} ({f['name']})" for f in matches[1:])
        warn(
            f"multiple story-point fields found; using {chosen['id']} "
            f"({chosen['name']}); alternatives: {others}",
            warnings,
        )
    return chosen.get("id")


# ---------------------------------------------------------------------------
# Value parsing
# ---------------------------------------------------------------------------

def parse_pairs(raw, what):
    """Parse 'A=B' comma/repeat-separated pairs into an ordered dict."""
    result = {}
    for item in raw:
        for pair in item.split(","):
            pair = pair.strip()
            if not pair:
                continue
            if "=" not in pair:
                die(f"invalid {what} entry {pair!r}; expected KEY=VALUE")
            key, _, value = pair.partition("=")
            key, value = key.strip(), value.strip()
            if not key or not value:
                die(f"invalid {what} entry {pair!r}; expected KEY=VALUE")
            result[key] = value
    return result


def load_json_arg(raw, flag):
    """Parse a JSON flag value (inline JSON or @path-to-file) into a dict."""
    text = raw
    if raw.startswith("@"):
        path = raw[1:]
        try:
            with open(path, encoding="utf-8") as fh:
                text = fh.read()
        except OSError as e:
            die(f"could not read {flag} file {path}: {e}")
    try:
        data = json.loads(text)
    except json.JSONDecodeError as e:
        die(f"{flag} is not valid JSON: {e}")
    if not isinstance(data, dict) or not data:
        die(f"{flag} must be a non-empty JSON object")
    return data


def load_target_repos_json(raw):
    """Parse --target-repos-json (inline JSON or @path-to-file)."""
    data = load_json_arg(raw, "--target-repos-json")
    return data


def load_projects_json(raw):
    """Parse --projects-json (the whole tracker.project_routing block)."""
    return load_json_arg(raw, "--projects-json")


def parse_project_repos(raw):
    """Parse repeatable --project-repos KEY=org/repo1,org/repo2 values."""
    result = {}
    for item in raw or []:
        if "=" not in item:
            die(f"invalid --project-repos entry {item!r}; expected "
                "KEY=org/repo1,org/repo2")
        key, _, value = item.partition("=")
        key = key.strip()
        repos = [r.strip() for r in value.split(",") if r.strip()]
        if not key or not repos:
            die(f"invalid --project-repos entry {item!r}; expected "
                "KEY=org/repo1,org/repo2")
        for repo in repos:
            if repo not in result.setdefault(key, []):
                result[key].append(repo)
    return result


def apply_project_repos(projects, project_repos):
    """Fold the --project-repos subsets into the project entries.

    A project that gains a repo subset becomes the object form; one without a
    subset stays a plain description string, so a single-project config keeps
    the simplest possible shape.
    """
    for key, repos in (project_repos or {}).items():
        if key not in projects:
            die(f"--project-repos names project {key!r}, which has no --project "
                "entry")
        entry = projects[key]
        if isinstance(entry, str):
            entry = {"description": entry}
        entry["repos"] = list(repos)
        projects[key] = entry
    return projects


def validate_projects(projects, target_repos, default_project, self_project):
    """Validate project entries and every project -> repo reference."""
    if not projects:
        die("no Jira projects configured; pass --project or --projects-json")
    for key, entry in projects.items():
        if not isinstance(key, str) or not key:
            die("project keys must be non-empty strings")
        if isinstance(entry, str):
            if not entry:
                die(f"project {key!r} needs a non-empty description")
            continue
        if not isinstance(entry, dict):
            die(f"project {key!r} must be a description string or a JSON object")
        if not entry.get("description"):
            die(f"project {key!r} is missing its `description`")
        unknown = [
            f for f in entry
            if f not in PROJECT_REQUIRED_FIELDS + PROJECT_OPTIONAL_FIELDS
        ]
        if unknown:
            die(f"project {key!r} has unknown field(s): " + ", ".join(unknown))
        repos = entry.get("repos") or []
        if not isinstance(repos, list) or not all(isinstance(r, str) for r in repos):
            die(f"project {key!r}'s `repos` must be a list of org/repo strings")
        for repo in repos:
            if repo not in target_repos:
                die(f"project {key!r} lists repo {repo!r}, which is not a "
                    "configured target repo")
        default_repo = entry.get("default_repo")
        if default_repo and repos and default_repo not in repos:
            die(f"project {key!r}'s `default_repo` {default_repo!r} is not one of "
                "its own repos")
        status_map = entry.get("status_map")
        if status_map is not None:
            if not isinstance(status_map, dict) or not status_map:
                die(f"project {key!r}'s `status_map` must be a non-empty object")
            unknown_states = [s for s in status_map if s not in FACTORY_STATES]
            if unknown_states:
                die(f"project {key!r}'s `status_map` has unknown factory state(s): "
                    + ", ".join(unknown_states))
    if default_project not in projects:
        die(f"default project {default_project!r} is not a configured project")
    if self_project and self_project not in projects:
        warn(f"self_project {self_project!r} is not a routed project; the "
             "factory's own tickets will use the site-wide tracker defaults")

    scoped = {k: e for k, e in projects.items()
              if isinstance(e, dict) and e.get("repos")}
    if scoped and len(scoped) == len(projects):
        referenced = {r for e in scoped.values() for r in e["repos"]}
        for repo in target_repos:
            if repo not in referenced:
                warn(f"target repo {repo!r} is not owned by any project, so no "
                     "ticket can route to it")
    elif len(projects) > 1 and not scoped:
        warn(f"{len(projects)} projects are routed but none declares a repo "
             "subset, so every ticket may route to every target repo; pass "
             "--project-repos (or --projects-json) to scope routing")


def validate_target_repos(target_repos):
    for repo, entry in target_repos.items():
        if "/" not in repo:
            die(f"target repo key {repo!r} must be org/repo")
        if not isinstance(entry, dict):
            die(f"target repo {repo!r} entry must be a JSON object")
        missing = [f for f in TARGET_REPO_REQUIRED_FIELDS if not entry.get(f)]
        if missing:
            die(f"target repo {repo!r} is missing required field(s): "
                + ", ".join(missing))
        unknown = [
            f for f in entry
            if f not in TARGET_REPO_REQUIRED_FIELDS + TARGET_REPO_OPTIONAL_FIELDS
        ]
        if unknown:
            die(f"target repo {repo!r} has unknown field(s): " + ", ".join(unknown))


# ---------------------------------------------------------------------------
# Interactive prompts
# ---------------------------------------------------------------------------

def prompt(question, default=None, required=True):
    suffix = f" [{default}]" if default not in (None, "") else ""
    while True:
        sys.stderr.write(f"{question}{suffix}: ")
        sys.stderr.flush()
        answer = input().strip()
        if not answer and default is not None:
            return default
        if answer or not required:
            return answer


def prompt_bool(question, default):
    raw = prompt(question + " (y/n)", "y" if default else "n")
    return raw.strip().lower() in ("y", "yes", "true", "1")


def interactive_values(args, jira_env, warnings):
    """Prompt for every value not already provided by a flag."""
    print("factory-init: interactive setup (Ctrl+C to abort; defaults in [])",
          file=sys.stderr)
    self_repo = args.self_repo or prompt(
        "org/repo of YOUR copy of this template (self repo)")

    projects = parse_pairs(args.project, "--project") if args.project else {}
    while not projects:
        key = prompt("Jira project key the factory files tickets in (e.g. ENG)")
        desc = prompt(f"one-line description of what project {key} owns")
        projects[key] = desc
        while prompt_bool("add another routed project?", False):
            key = prompt("Jira project key")
            desc = prompt(f"one-line description of what project {key} owns")
            projects[key] = desc

    default_project = args.default_project or prompt(
        "fallback project key when routing finds no match",
        next(iter(projects)))
    self_project = args.self_project or prompt(
        "project key for the factory's own self-improvement tickets",
        default_project)
    browse_url = args.browse_url or prompt(
        "human Jira site URL (e.g. https://yourcompany.atlassian.net; empty to omit)",
        os.environ.get("JIRA_BASE_URL", ""), required=False)
    issue_type = args.issue_type or prompt(
        "Jira issue type for factory tickets", "Task")

    status_map = parse_pairs(args.status_map, "--status-map") if args.status_map else {}
    if not status_map:
        known = None
        if jira_env:
            known = discover_statuses(jira_env, default_project, warnings)
            if known:
                print("factory-init: statuses in project "
                      f"{default_project}: {', '.join(sorted(known))}",
                      file=sys.stderr)
        for state in FACTORY_STATES:
            status_map[state] = prompt(
                f"Jira status name for factory state {state!r}",
                DEFAULT_STATUS_MAP[state])

    story_points = args.story_points_field
    if story_points is None:
        discovered = discover_story_points_field(jira_env, warnings) if jira_env else None
        story_points = prompt(
            "story-points custom field id ('none' to disable estimates)",
            discovered or COMMON_STORY_POINTS_FIELD)

    target_repos = (
        load_target_repos_json(args.target_repos_json)
        if args.target_repos_json else {}
    )
    while not target_repos:
        repo = prompt("target org/repo the factory ships changes to")
        entry = {
            "description": prompt(f"one-line description of what {repo} owns"),
            "base_branch": prompt("base branch PRs open against", "main"),
            "validate_command": prompt(
                "the one command that validates a change (build+lint+tests)"),
            "test_guidance": prompt(
                "one line on how regression tests are written and run there"),
        }
        app_start = prompt(
            "command that boots the app for UI verification (empty if headless)",
            "", required=False)
        if app_start:
            entry["app_start_command"] = app_start
            entry["app_url"] = prompt(
                "local URL the running app serves", "http://localhost:8000")
        target_repos[repo] = entry
        while prompt_bool("add another target repo?", False):
            repo = prompt("target org/repo")
            entry = {
                "description": prompt(f"one-line description of what {repo} owns"),
                "base_branch": prompt("base branch PRs open against", "main"),
                "validate_command": prompt("the one validation command"),
                "test_guidance": prompt("one line of regression-test guidance"),
            }
            app_start = prompt(
                "command that boots the app for UI verification (empty if headless)",
                "", required=False)
            if app_start:
                entry["app_start_command"] = app_start
                entry["app_url"] = prompt(
                    "local URL the running app serves", "http://localhost:8000")
            target_repos[repo] = entry

    default_target_repo = args.default_target_repo or prompt(
        "fallback target repo when routing finds no match",
        next(iter(target_repos)))

    # Which repos does each project own? Routing stays scoped when a ticket can
    # only reach its own project's repos, which matters as soon as there is
    # more than one project or more than one repo.
    project_repos = parse_project_repos(args.project_repos)
    if not args.projects_json and not project_repos and (
            len(projects) > 1 or len(target_repos) > 1):
        print("factory-init: map each Jira project to the repos it owns "
              "(comma-separated; empty = every target repo)", file=sys.stderr)
        for key in projects:
            answer = prompt(
                f"repos owned by project {key} "
                f"(of {', '.join(target_repos)})",
                "", required=False)
            repos = [r.strip() for r in answer.split(",") if r.strip()]
            if repos:
                project_repos[key] = repos
    projects = apply_project_repos(projects, project_repos)

    spec_approval = (
        args.spec_approval_required
        if args.spec_approval_required is not None
        else prompt_bool("pause for human spec approval before implementation?", True)
    )

    return {
        "self_repo": self_repo,
        "browse_url": browse_url or None,
        "projects": projects,
        "default_project": default_project,
        "self_project": self_project,
        "issue_type": issue_type,
        "status_map": status_map,
        "story_points_field": story_points,
        "target_repos": target_repos,
        "default_target_repo": default_target_repo,
        "spec_approval_required": spec_approval,
    }


def flag_values(args, jira_env, warnings):
    """Resolve every value from flags (non-interactive); fail loud on gaps."""
    missing = []
    if not args.self_repo:
        missing.append("--self-repo")
    if not (args.project or args.projects_json):
        missing.append("--project or --projects-json")
    if not (args.target_repos_json or args.target_repo):
        missing.append("--target-repos-json or --target-repo")
    if missing:
        die("missing required flag(s): " + ", ".join(missing)
            + " (or run with --interactive)")

    if args.projects_json:
        projects = load_projects_json(args.projects_json)
        if args.project:
            projects.update(parse_pairs(args.project, "--project"))
    else:
        projects = parse_pairs(args.project, "--project")
    projects = apply_project_repos(projects, parse_project_repos(args.project_repos))
    default_project = args.default_project or next(iter(projects))
    if default_project not in projects:
        die(f"--default-project {default_project!r} is not a configured project")

    status_map = dict(DEFAULT_STATUS_MAP)
    status_map.update(parse_pairs(args.status_map, "--status-map"))
    unknown_states = [s for s in status_map if s not in FACTORY_STATES]
    if unknown_states:
        die("unknown factory state(s) in --status-map: "
            + ", ".join(unknown_states)
            + f"; the factory states are: {', '.join(FACTORY_STATES)}")

    story_points = args.story_points_field
    if story_points is None:
        discovered = discover_story_points_field(jira_env, warnings) if jira_env else None
        if discovered:
            story_points = discovered
        else:
            story_points = COMMON_STORY_POINTS_FIELD
            warn(
                "story-points field not discovered; defaulting to "
                f"{COMMON_STORY_POINTS_FIELD} - verify it per SETUP.md or pass "
                "--story-points-field (use 'none' to disable estimates)",
                warnings,
            )

    if args.target_repos_json:
        target_repos = load_target_repos_json(args.target_repos_json)
    else:
        entry = {
            "description": args.target_description,
            "base_branch": args.target_base_branch,
            "validate_command": args.target_validate_command,
            "test_guidance": args.target_test_guidance,
        }
        gaps = [k for k, v in entry.items() if not v]
        if gaps:
            die("--target-repo also requires --target-description, "
                "--target-base-branch, --target-validate-command, and "
                "--target-test-guidance (missing: "
                + ", ".join("--target-" + g.replace("_", "-") for g in gaps) + ")")
        if args.target_app_start_command:
            entry["app_start_command"] = args.target_app_start_command
        if args.target_app_url:
            entry["app_url"] = args.target_app_url
        if args.target_environment_id:
            entry["environment_id"] = args.target_environment_id
        if args.target_runner_id:
            entry["runner_id"] = args.target_runner_id
        target_repos = {args.target_repo: entry}

    default_target_repo = args.default_target_repo or next(iter(target_repos))
    if default_target_repo not in target_repos:
        die(f"--default-target-repo {default_target_repo!r} is not a configured "
            "target repo")

    return {
        "self_repo": args.self_repo,
        "browse_url": args.browse_url or None,
        "projects": projects,
        "default_project": default_project,
        "self_project": args.self_project or default_project,
        "issue_type": args.issue_type or "Task",
        "status_map": status_map,
        "story_points_field": story_points,
        "target_repos": target_repos,
        "default_target_repo": default_target_repo,
        "spec_approval_required": (
            args.spec_approval_required
            if args.spec_approval_required is not None else True
        ),
    }


# ---------------------------------------------------------------------------
# Config composition + writing
# ---------------------------------------------------------------------------

def build_foreman_config(values):
    tracker = {
        "provider": "jira",
        "project_routing": values["projects"],
        "default_project": values["default_project"],
        "status_map": {s: values["status_map"][s] for s in FACTORY_STATES},
        "story_points_field": (
            None
            if str(values["story_points_field"]).lower() in ("none", "null", "")
            else values["story_points_field"]
        ),
        "issue_type": values["issue_type"],
    }
    if values.get("browse_url"):
        tracker["browse_url"] = values["browse_url"].rstrip("/")
    return {
        "tracker": tracker,
        "target_repos": values["target_repos"],
        "default_target_repo": values["default_target_repo"],
        "spec_approval_required": values["spec_approval_required"],
        "self_repo": values["self_repo"],
        "self_project": values["self_project"],
    }


def merge_foreman_config(path, values, args, warnings):
    """Fold the supplied projects and target repos into an existing config.

    This is the onboarding path for a factory that already runs: adding a Jira
    project or a repo should not rewrite the status map, the story-points field,
    or anybody else's routing. Only the two routing maps are merged (new keys
    added, supplied keys replaced), plus any value the caller passed explicitly.
    """
    try:
        with open(path, encoding="utf-8") as fh:
            existing = json.load(fh)
    except (OSError, json.JSONDecodeError) as e:
        die(f"could not read existing {path} to merge into: {e}")
    if not isinstance(existing, dict):
        die(f"{path} must be a JSON object to merge into")

    merged = copy.deepcopy(existing)
    tracker = merged.get("tracker")
    if not isinstance(tracker, dict):
        tracker = {}
        merged["tracker"] = tracker
    routing = tracker.get("project_routing")
    if not isinstance(routing, dict):
        routing = {}
    routing.update(values["projects"])
    tracker["project_routing"] = routing

    target_repos = merged.get("target_repos")
    if not isinstance(target_repos, dict):
        target_repos = {}
    target_repos.update(values["target_repos"])
    merged["target_repos"] = target_repos

    if existing.get("self_repo") and existing["self_repo"] != values["self_repo"]:
        warn(f"--merge keeps the existing self_repo {existing['self_repo']!r} "
             f"(ignoring {values['self_repo']!r})", warnings)

    # Only values the caller passed explicitly override the existing config.
    if args.default_project:
        tracker["default_project"] = args.default_project
    if args.issue_type:
        tracker["issue_type"] = args.issue_type
    if args.story_points_field is not None:
        tracker["story_points_field"] = (
            None if str(args.story_points_field).lower() in ("none", "null", "")
            else args.story_points_field
        )
    if args.status_map:
        status_map = tracker.get("status_map")
        status_map = dict(status_map) if isinstance(status_map, dict) else {}
        status_map.update(parse_pairs(args.status_map, "--status-map"))
        tracker["status_map"] = status_map
    if args.browse_url:
        tracker["browse_url"] = args.browse_url.rstrip("/")
    if args.default_target_repo:
        merged["default_target_repo"] = args.default_target_repo
    if args.self_project:
        merged["self_project"] = args.self_project
    if args.spec_approval_required is not None:
        merged["spec_approval_required"] = args.spec_approval_required

    default_target = merged.get("default_target_repo")
    if default_target and default_target not in target_repos:
        die(f"after the merge, default_target_repo {default_target!r} is not a "
            "configured target repo; pass --default-target-repo")
    default_project = tracker.get("default_project")
    if default_project and default_project not in routing:
        die(f"after the merge, default_project {default_project!r} is not a "
            "routed project; pass --default-project")
    validate_target_repos(target_repos)
    validate_projects(routing, target_repos, default_project,
                      merged.get("self_project"))
    return merged


def build_track_config(repo_root, track, self_repo):
    """The track config with repos.self updated and everything else preserved."""
    path = os.path.join(repo_root, track, "config.json")
    config = {}
    if os.path.isfile(path):
        try:
            with open(path, encoding="utf-8") as fh:
                config = json.load(fh)
        except (OSError, json.JSONDecodeError) as e:
            die(f"could not read existing {path}: {e}")
        if not isinstance(config, dict):
            config = {}
    agent = config.get("agent") if isinstance(config.get("agent"), dict) else {}
    if not agent.get("entrypoint_skill") or agent.get("entrypoint_skill") == PLACEHOLDER:
        agent["entrypoint_skill"] = DEFAULT_ENTRYPOINT_SKILLS[track]
    config["agent"] = agent
    if not config.get("model") or config.get("model") == PLACEHOLDER:
        config["model"] = DEFAULT_MODEL
    config["repos"] = {"self": self_repo}
    return config


def is_pristine(path):
    """True when the file is absent or still contains REPLACE_ME placeholders."""
    if not os.path.isfile(path):
        return True
    try:
        with open(path, encoding="utf-8") as fh:
            return PLACEHOLDER in fh.read()
    except OSError:
        return True


def write_json(path, data, dry_run, written):
    if dry_run:
        written.append({"path": path, "dry_run": True, "content": data})
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    written.append({"path": path, "dry_run": False})


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="factory-init",
        description=(
            "Bootstrap the factory's config files (foreman/config.json, the "
            "four track configs, and a reviewer_overrides.json skeleton) from "
            "flags or interactive prompts, with optional Jira autodiscovery "
            "of workflow statuses and the story-points field."
        ),
    )
    parser.add_argument("--self-repo",
                        help="org/repo of YOUR copy of this template")
    parser.add_argument("--self-project",
                        help="Jira project key for the factory's own "
                             "self-improvement tickets (default: the default "
                             "project)")
    parser.add_argument("--browse-url",
                        help="human Jira site URL for clickable issue links "
                             "(needed when $JIRA_BASE_URL is the "
                             "api.atlassian.com gateway)")
    parser.add_argument("--project", action="append", default=[],
                        metavar="KEY=DESCRIPTION",
                        help="a routed Jira project and what it owns "
                             "(repeatable / comma-separated)")
    parser.add_argument("--project-repos", action="append", default=[],
                        metavar="KEY=ORG/REPO1,ORG/REPO2",
                        help="the target repos a Jira project owns "
                             "(repeatable, one project per flag). Scopes "
                             "routing so a ticket in that project can only "
                             "reach those repos; omit to leave every target "
                             "repo a candidate")
    parser.add_argument("--projects-json", metavar="JSON|@FILE",
                        help="full tracker.project_routing map as inline JSON "
                             "or @file. A value is either a description string "
                             "or an object with description, repos, "
                             "default_repo, and optional per-project "
                             "status_map, story_points_field, issue_type, "
                             "spec_approval_required, environment_id, "
                             "runner_id. Use this to generate config for many "
                             "projects from your own source of truth")
    parser.add_argument("--default-project",
                        help="fallback project key (default: first --project)")
    parser.add_argument("--issue-type", help="Jira issue type (default: Task)")
    parser.add_argument("--status-map", action="append", default=[],
                        metavar="STATE=JIRA_STATUS",
                        help="map a factory state (Triage, Todo, In Progress, "
                             "In Review, Done, Canceled) to your real Jira "
                             "status name (repeatable / comma-separated; "
                             "unmapped states use a common default)")
    parser.add_argument("--story-points-field",
                        help="Jira custom field id for story points, or "
                             "'none' to disable estimates (default: "
                             "autodiscover, else customfield_10016)")
    parser.add_argument("--target-repos-json", metavar="JSON|@FILE",
                        help="full target_repos map as inline JSON or @file "
                             "(keys org/repo; fields description, base_branch, "
                             "validate_command, test_guidance, and optional "
                             "app_start_command, app_url, environment_id, "
                             "runner_id)")
    parser.add_argument("--target-repo",
                        help="single target org/repo (alternative to "
                             "--target-repos-json)")
    parser.add_argument("--target-description",
                        help="what the single target repo owns")
    parser.add_argument("--target-base-branch",
                        help="base branch of the single target repo")
    parser.add_argument("--target-validate-command",
                        help="validation command of the single target repo")
    parser.add_argument("--target-test-guidance",
                        help="regression-test guidance for the single target repo")
    parser.add_argument("--target-app-start-command",
                        help="optional app-boot command for UI verification")
    parser.add_argument("--target-app-url",
                        help="optional local URL of the running app")
    parser.add_argument("--target-environment-id",
                        help="optional Oz cloud environment id for the single "
                             "target repo (the environment that has its "
                             "toolchain and clone); children working on that "
                             "repo are dispatched into it")
    parser.add_argument("--target-runner-id",
                        help="optional Oz runner id for the single target repo "
                             "(when its build needs specific compute)")
    parser.add_argument("--default-target-repo",
                        help="fallback target repo (default: first configured)")
    spec = parser.add_mutually_exclusive_group()
    spec.add_argument("--spec-approval-required", dest="spec_approval_required",
                      action="store_true", default=None,
                      help="pause for human spec approval (the default)")
    spec.add_argument("--no-spec-approval-required", dest="spec_approval_required",
                      action="store_false",
                      help="let committed specs auto-advance with no pause")
    parser.add_argument("--interactive", action="store_true",
                        help="prompt for every value (default when run on a "
                             "TTY with no value flags)")
    parser.add_argument("--no-discover", action="store_true",
                        help="skip Jira autodiscovery even when $JIRA_* is set")
    overwrite = parser.add_mutually_exclusive_group()
    overwrite.add_argument("--force", action="store_true",
                           help="replace an already-customized "
                                "foreman/config.json wholesale")
    overwrite.add_argument("--merge", action="store_true",
                           help="merge the supplied projects and target repos "
                                "into an already-customized "
                                "foreman/config.json, keeping every other "
                                "existing value (how you onboard one more "
                                "project or repo)")
    parser.add_argument("--dry-run", action="store_true",
                        help="print the resolved configs without writing")
    parser.add_argument("--repo-root", default=DEFAULT_REPO_ROOT,
                        help=argparse.SUPPRESS)
    args = parser.parse_args(argv)

    warnings = []
    jira_env = None if args.no_discover else _jira_env()
    if jira_env is None and not args.no_discover:
        warn("$JIRA_BASE_URL / $JIRA_EMAIL / $JIRA_API_TOKEN not all set; "
             "skipping Jira autodiscovery (values are used as given)", warnings)

    has_value_flags = bool(args.self_repo or args.project or args.projects_json
                           or args.target_repo or args.target_repos_json)
    interactive = args.interactive or (not has_value_flags and sys.stdin.isatty())
    if interactive:
        try:
            values = interactive_values(args, jira_env, warnings)
        except (KeyboardInterrupt, EOFError):
            die("aborted")
    else:
        values = flag_values(args, jira_env, warnings)

    if "/" not in values["self_repo"]:
        die(f"self repo {values['self_repo']!r} must be org/repo")
    validate_target_repos(values["target_repos"])
    validate_projects(values["projects"], values["target_repos"],
                      values["default_project"], values.get("self_project"))
    missing_states = [s for s in FACTORY_STATES if not values["status_map"].get(s)]
    if missing_states:
        die("status_map is missing factory state(s): " + ", ".join(missing_states))

    # Validate the status map against the real workflow of EVERY routed project
    # when discoverable: multi-project sites often use different workflows, and
    # a project whose statuses differ needs a per-project status_map override.
    if jira_env:
        for project in values["projects"]:
            known = discover_statuses(jira_env, project, warnings)
            if not known:
                continue
            lowered = {k.lower() for k in known}
            effective = dict(values["status_map"])
            entry = values["projects"][project]
            if isinstance(entry, dict) and isinstance(entry.get("status_map"), dict):
                effective.update(entry["status_map"])
            mismatched = [
                f"{state} -> {status}" for state, status in effective.items()
                if status.lower() not in lowered
            ]
            if mismatched:
                warn(
                    f"project {project}: " + "; ".join(mismatched)
                    + " is not a status in that project (statuses: "
                    + ", ".join(sorted(known))
                    + "); add a per-project `status_map` override for it",
                    warnings,
                )

    foreman_path = os.path.join(args.repo_root, "foreman", "config.json")
    customized = not is_pristine(foreman_path)
    if customized and not (args.force or args.merge) and not args.dry_run:
        die(f"{foreman_path} is already customized (no {PLACEHOLDER} "
            "placeholders); pass --merge to add the supplied projects/repos, or "
            "--force to replace it")

    foreman_config = build_foreman_config(values)
    if args.merge and customized:
        foreman_config = merge_foreman_config(foreman_path, values, args, warnings)

    written, skipped = [], []
    write_json(foreman_path, foreman_config, args.dry_run, written)
    for track in TRACKS:
        path = os.path.join(args.repo_root, track, "config.json")
        write_json(path, build_track_config(args.repo_root, track,
                                            values["self_repo"]),
                   args.dry_run, written)

    overrides_path = os.path.join(args.repo_root, "scripts",
                                  "reviewer_overrides.json")
    if os.path.isfile(overrides_path):
        skipped.append({"path": overrides_path,
                        "reason": "exists; never overwritten"})
    else:
        write_json(overrides_path, REVIEWER_OVERRIDES_SKELETON,
                   args.dry_run, written)

    print(json.dumps({
        "written": written,
        "skipped": skipped,
        "warnings": warnings,
        "next_steps": [
            "seed scripts/reviewer_overrides.json with your team's identities "
            "(SETUP.md step 7)",
            "run scripts/check to validate the repo",
            "commit the config changes to your copy of the template",
        ],
    }, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
