#!/usr/bin/env python3
"""mock-issue-tracker -- in-memory mock issue-tracker provider for the factory loop (evals only).

A drop-in stand-in for `scripts/jira` used **exclusively by the eval harness**
(`scripts/factory-eval`) so an eval run can exercise the full factory pipeline
without touching a real issue tracker: no network, no `$JIRA_API_TOKEN`, and no
real tickets created in the customer's Jira. Select it via the tracker seam with
`--provider mock-issue-tracker` or `FACTORY_TRACKER_PROVIDER=mock-issue-tracker`
(see `scripts/tracker`).

It exposes the **same subcommands, flags, and JSON output shapes** as the real
tracker provider, so every caller (agent skills + helper scripts) works unchanged:
  create-issue    Create a new issue and print its identifier/url/id.
  comment         Create a top-level issue comment or reply to a comment.
  update-comment  Update (edit) an existing comment on an issue.
  list-labels     List the workspace's issue labels.
  search-issues   Keyword-search open issues for deduplication.
  get-issue       Read one issue's status, labels, estimate, and people.
  update-issue    Set an issue's workflow status, add/remove labels, and/or
                  set/append its description and title.
  find-user       Look up a user by email or display name; returns a
                  deterministic synthesized match with a mention token.

Behavior differences from the real provider (by design):
  * It **always succeeds** for the operations agents perform: it never fails on
    "issue not found", "team not found", missing auth, or a network error. An
    unknown issue id is synthesized on read/update so the loop keeps moving.
  * State is kept **in memory** for the lifetime of the mock "service" — emulated
    across separate CLI invocations by a local JSON store on disk (a single
    process can't outlive one command). This is what lets a create-issue be read
    back by a later get-issue/update-issue/search-issues **within the same eval
    environment**, so factory agents can advance to their next step. The store
    lives at $FACTORY_MOCK_TRACKER_STORE, else a stable path under the system
    temp dir. Delete it to reset the mock.

No third-party dependencies; Python 3 stdlib only.
"""
import argparse
import json
import os
import sys
import tempfile
import uuid

# Base for the fake identifier/URL space. Nothing dereferences these; they only
# need to look and parse like a tracker's (TEAM-NUMBER identifiers, http URLs).
BASE_URL = "https://mock.tracker.local"
DEFAULT_TEAM = "Mock"

# Canonical labels always available so agents can read/apply the pipeline gate
# labels and the common categorization labels the loop relies on. list-labels
# returns these plus any labels that have landed on stored issues.
_CANONICAL_LABELS = [
    "triage-done",
    "spec-done",
    "impl-done",
    "review-done",
    "blocked",
    "bug",
    "feature",
    "enhancement",
    "chore",
]

# Common words to exclude from keyword matching in search-issues (mirrors the
# jira provider).
_STOP_WORDS = {
    "a", "an", "the", "and", "or", "but", "in", "on", "at", "to", "for",
    "of", "with", "is", "it", "not", "be", "as", "by", "are", "was",
    "me", "my", "i", "we", "do", "did", "has", "have",
}

# Map a human workflow status name to a tracker "state type" so downstream
# filters (e.g. search-issues excluding completed/canceled) and readers behave
# like the real provider.
_STATE_TYPES = {
    "triage": "triage",
    "backlog": "backlog",
    "todo": "unstarted",
    "unstarted": "unstarted",
    "in progress": "started",
    "in review": "started",
    "started": "started",
    "done": "completed",
    "completed": "completed",
    "canceled": "canceled",
    "cancelled": "canceled",
    "duplicate": "canceled",
}
_DEFAULT_STATUS = "Triage"


def die(msg, code=1):
    sys.stderr.write(msg.rstrip() + "\n")
    sys.exit(code)


# ---------------------------------------------------------------------------
# The "in-memory" store, persisted to a local JSON file so it survives across
# the separate CLI invocations that make up one eval run.
# ---------------------------------------------------------------------------

def _store_path():
    override = os.environ.get("FACTORY_MOCK_TRACKER_STORE")
    if override:
        return override
    return os.path.join(tempfile.gettempdir(), "factory-mock-tracker.json")


def _empty_store():
    return {"seq": 0, "issues": {}, "comments": []}


def _load_store():
    path = _store_path()
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return _empty_store()
    if not isinstance(data, dict):
        return _empty_store()
    data.setdefault("seq", 0)
    data.setdefault("issues", {})
    data.setdefault("comments", [])
    return data


def _save_store(store):
    path = _store_path()
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    # Atomic write: temp file in the same dir, then replace.
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".mock-tracker-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(store, fh, indent=2)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _new_uuid():
    return str(uuid.uuid4())


def _team_key(team):
    """Derive a short TEAM key for identifiers from a team name (or key).

    Uses the uppercase initials of the name's tokens (e.g. "Eng-Quality FA" ->
    "EQF"); falls back to the first alnum chars, then "MOCK".
    """
    tokens = [t for t in "".join(c if c.isalnum() else " " for c in (team or "")).split() if t]
    if not tokens:
        return "MOCK"
    if len(tokens) == 1:
        return tokens[0][:4].upper()
    return "".join(t[0] for t in tokens).upper()


def _state_type(status):
    if not status:
        return "started"
    return _STATE_TYPES.get(status.strip().lower(), "started")


def _issue_url(identifier):
    return f"{BASE_URL}/issue/{identifier}"


def _person(name, email):
    if not name and not email:
        return None
    return {"name": name, "email": email}


def _synthesize_issue(identifier):
    """A default record for an id the mock has never seen, so reads never fail."""
    return {
        "id": _new_uuid(),
        "identifier": identifier,
        "url": _issue_url(identifier),
        "title": f"Mock issue {identifier}",
        "description": "",
        "team": DEFAULT_TEAM,
        "project": None,
        "parent": None,
        "estimate": None,
        "labels": [],
        "assignee": None,
        "requester": None,
        "status": _DEFAULT_STATUS,
    }


def _get_or_create(store, identifier):
    issue = store["issues"].get(identifier)
    if issue is None:
        issue = _synthesize_issue(identifier)
        store["issues"][identifier] = issue
    return issue


# ---------------------------------------------------------------------------
# Subcommands (output shapes mirror the real tracker provider surface)
# ---------------------------------------------------------------------------

def cmd_create_issue(args):
    store = _load_store()
    store["seq"] += 1
    identifier = f"{_team_key(args.team)}-{store['seq']}"

    labels = []
    if args.labels:
        labels = [l.strip() for l in args.labels.split(",") if l.strip()]

    issue = {
        "id": _new_uuid(),
        "identifier": identifier,
        "url": _issue_url(identifier),
        "title": args.title,
        "description": args.description,
        "team": args.team,
        "project": args.project,
        "parent": args.parent,
        "estimate": args.estimate,
        "labels": labels,
        "assignee": _person(None, args.assignee) if args.assignee else None,
        "requester": None,
        "status": args.status or _DEFAULT_STATUS,
    }
    store["issues"][identifier] = issue
    _save_store(store)

    print(json.dumps({
        "identifier": issue["identifier"],
        "url": issue["url"],
        "id": issue["id"],
    }, indent=2))
    return 0


def cmd_comment(args):
    store = _load_store()
    comment_id = _new_uuid()

    issue_identifier = None
    issue_url = None
    if args.issue:
        issue = _get_or_create(store, args.issue.strip())
        issue_identifier = issue["identifier"]
        issue_url = issue["url"]

    record = {
        "id": comment_id,
        "url": f"{BASE_URL}/comment/{comment_id}",
        "issue": issue_identifier,
        "issueUrl": issue_url,
        "parentId": args.parent,
        "body": args.body,
    }
    store["comments"].append(record)
    _save_store(store)

    print(json.dumps(record, indent=2))
    return 0


def cmd_update_comment(args):
    store = _load_store()
    comment_id = args.comment_id.strip()
    for record in store.get("comments", []):
        if record.get("id") == comment_id:
            record["body"] = args.body
            _save_store(store)
            print(json.dumps(record, indent=2))
            return 0
    # Not found — synthesize a record (mock always succeeds)
    issue_id = args.issue.strip() if hasattr(args, "issue") and args.issue else None
    record = {
        "id": comment_id,
        "url": f"{BASE_URL}/comment/{comment_id}",
        "issue": issue_id,
        "body": args.body,
    }
    store.setdefault("comments", []).append(record)
    _save_store(store)
    print(json.dumps(record, indent=2))
    return 0


def _all_label_names(store):
    names = set(_CANONICAL_LABELS)
    for issue in store["issues"].values():
        for name in issue.get("labels") or []:
            names.add(name)
    return names


def cmd_list_labels(args):
    store = _load_store()
    labels = sorted(
        (
            {"id": f"label-{name.lower().replace(' ', '-').replace(chr(39), '')}", "name": name}
            for name in _all_label_names(store)
        ),
        key=lambda l: l["name"],
    )
    print(json.dumps(labels, indent=2))
    return 0


def _keywords(query_text):
    return [w for w in query_text.lower().split() if w not in _STOP_WORDS and len(w) > 2]


def cmd_search_issues(args):
    store = _load_store()
    keywords = _keywords(args.query_text) or [args.query_text.strip().lower()]

    results = []
    for issue in store["issues"].values():
        state_type = _state_type(issue.get("status"))
        if state_type in ("completed", "canceled"):
            continue
        title = (issue.get("title") or "").lower()
        if any(kw and kw in title for kw in keywords):
            results.append({
                "identifier": issue["identifier"],
                "title": issue.get("title"),
                "url": issue["url"],
                "state": issue.get("status"),
            })
    print(json.dumps(results, indent=2))
    return 0


def cmd_list_projects(args):
    """Return an empty project list (no projects configured in the mock).

    The mock returns no projects so callers fall back to no-project assignment,
    which is the safe factory-loop default. This prevents evals from accidentally
    assigning a project based on stale or fabricated state.
    """
    print(json.dumps([], indent=2))
    return 0


def cmd_get_issue(args):
    store = _load_store()
    identifier = args.identifier.strip()
    issue = store["issues"].get(identifier) or _synthesize_issue(identifier)

    status = issue.get("status")
    print(json.dumps({
        "identifier": issue["identifier"],
        "url": issue["url"],
        "title": issue.get("title"),
        "description": issue.get("description"),
        "estimate": issue.get("estimate"),
        "status": status,
        "stateType": _state_type(status),
        "labels": list(issue.get("labels") or []),
        "assignee": issue.get("assignee"),
        "requester": issue.get("requester"),
    }, indent=2))
    return 0


def cmd_find_user(args):
    """Mirror the real provider's find-user: always returns one match.

    The accountId is synthesized deterministically from the query so repeated
    lookups (and mention tokens built from them) are stable within an eval.
    """
    query = args.query.strip()
    local = query.split("@", 1)[0] if "@" in query else query
    name = " ".join(
        part.capitalize()
        for part in local.replace(".", " ").replace("_", " ").split()
    ) or "Mock User"
    account_id = "mock:" + str(uuid.uuid5(uuid.NAMESPACE_DNS, query.lower()))
    print(json.dumps([{
        "accountId": account_id,
        "name": name,
        "email": query if "@" in query else None,
        "active": True,
        "mention": f"[~accountid:{account_id}]",
    }], indent=2))
    return 0


def cmd_update_issue(args):
    add_labels = [l.strip() for l in (args.add_label or []) if l.strip()]
    remove_labels = [l.strip() for l in (args.remove_label or []) if l.strip()]
    if args.description is not None and args.append_description is not None:
        die("update-issue: --description and --append-description are mutually exclusive")
    has_description = args.description is not None or args.append_description is not None
    if (
        not args.status
        and not add_labels
        and not remove_labels
        and not has_description
        and args.title is None
        and args.estimate is None
    ):
        die(
            "update-issue: provide at least one of --status, --estimate, "
            "--add-label, --remove-label, --description, --append-description, "
            "--title"
        )

    store = _load_store()
    issue = _get_or_create(store, args.identifier.strip())

    if args.title is not None:
        issue["title"] = args.title

    if args.status:
        issue["status"] = args.status

    if args.estimate is not None:
        issue["estimate"] = args.estimate

    if args.description is not None:
        issue["description"] = args.description
    elif args.append_description is not None:
        current = issue.get("description") or ""
        issue["description"] = (
            current + "\n\n" + args.append_description if current else args.append_description
        )

    if add_labels or remove_labels:
        labels = list(issue.get("labels") or [])
        lowered = {l.lower(): l for l in labels}
        for name in add_labels:
            if name.lower() not in lowered:
                labels.append(name)
                lowered[name.lower()] = name
        for name in remove_labels:
            existing = lowered.get(name.lower())
            if existing is not None:
                labels = [l for l in labels if l != existing]
        issue["labels"] = sorted(labels)

    store["issues"][issue["identifier"]] = issue
    _save_store(store)

    status = issue.get("status")
    print(json.dumps({
        "identifier": issue["identifier"],
        "url": issue["url"],
        "title": issue.get("title"),
        "status": status,
        "stateType": _state_type(status),
        "estimate": issue.get("estimate"),
        "labels": list(issue.get("labels") or []),
        "description": issue.get("description"),
    }, indent=2))
    return 0


def build_parser():
    parser = argparse.ArgumentParser(
        prog="mock-issue-tracker",
        description=(
            "In-memory mock issue-tracker provider (evals only): create-issue, "
            "comment, update-comment, list-labels, search-issues, get-issue, "
            "update-issue. Mirrors the real tracker provider's interface and always "
            "succeeds."
        ),
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_create = sub.add_parser("create-issue", help="Create a new issue.")
    p_create.add_argument("--title", required=True, help="Issue title.")
    p_create.add_argument("--description", required=True, help="Issue description (markdown).")
    p_create.add_argument("--team", default=DEFAULT_TEAM, help=f"Team name or key (default: {DEFAULT_TEAM}).")
    p_create.add_argument("--project", default=None, help="Project name to file the issue under (recorded only).")
    p_create.add_argument("--parent", help="Parent issue identifier to create this as a sub-issue (recorded only).")
    p_create.add_argument("--estimate", type=int, help="Size estimate (XS=1, S=2, M=3, L=5, XL=8).")
    p_create.add_argument("--labels", help="Comma-separated label names.")
    p_create.add_argument("--assignee", help="Assignee email address (recorded only).")
    p_create.add_argument("--delegate", help="Delegate agent/user display name (recorded only).")
    p_create.add_argument("--status", help="Initial workflow state name (default: Triage).")
    p_create.set_defaults(func=cmd_create_issue)

    p_comment = sub.add_parser("comment", help="Create an issue comment or reply to a comment.")
    target = p_comment.add_mutually_exclusive_group(required=True)
    target.add_argument("--issue", help="Issue identifier for a top-level comment, e.g. ENG-1234.")
    target.add_argument("--parent", help="Parent comment id for a reply.")
    p_comment.add_argument("--body", required=True, help="Comment body in markdown.")
    p_comment.set_defaults(func=cmd_comment)

    p_update_comment = sub.add_parser(
        "update-comment",
        help="Update (edit) an existing comment on an issue.",
    )
    p_update_comment.add_argument("--issue", required=True, help="Issue identifier.")
    p_update_comment.add_argument("--comment-id", required=True,
                                   help="ID of the comment to update.")
    p_update_comment.add_argument("--body", required=True, help="New comment body (markdown).")
    p_update_comment.set_defaults(func=cmd_update_comment)

    p_labels = sub.add_parser("list-labels", help="List the workspace's issue labels.")
    p_labels.add_argument("--team", default=DEFAULT_TEAM, help=f"Team name or key (default: {DEFAULT_TEAM}).")
    p_labels.set_defaults(func=cmd_list_labels)

    p_search = sub.add_parser("search-issues", help="Keyword-search open issues for deduplication.")
    p_search.add_argument("query_text", help="Key terms to search for (e.g. 'login endpoint 500').")
    p_search.add_argument(
        "--team",
        action="append",
        default=None,
        metavar="PROJECTKEY",
        help=(
            "Project key(s) to scope the search (repeatable; recorded only, the "
            "mock searches its whole store). Mirrors the real provider, whose "
            "default is every routed project."
        ),
    )
    p_search.set_defaults(func=cmd_search_issues)

    p_projects = sub.add_parser(
        "list-projects",
        help="List active projects for a team (always returns empty list in mock).",
    )
    p_projects.add_argument(
        "--team",
        default=DEFAULT_TEAM,
        help=f"Team name or key (default: {DEFAULT_TEAM}).",
    )
    p_projects.set_defaults(func=cmd_list_projects)

    p_get = sub.add_parser("get-issue", help="Read one issue's status, labels, estimate, and people.")
    p_get.add_argument("identifier", help="Issue identifier, e.g. ENG-1234.")
    p_get.set_defaults(func=cmd_get_issue)

    p_find_user = sub.add_parser(
        "find-user",
        help=(
            "Look up a user by email or display name; returns a deterministic "
            "synthesized match with accountId and mention token."
        ),
    )
    p_find_user.add_argument("query", metavar="QUERY",
                             help="Email address or display name to search for.")
    p_find_user.set_defaults(func=cmd_find_user)

    p_update = sub.add_parser(
        "update-issue",
        help=(
            "Set an issue's workflow status, add/remove labels, and/or "
            "set/append its description."
        ),
    )
    p_update.add_argument("identifier", help="Issue identifier, e.g. ENG-1234.")
    p_update.add_argument("--title", help="Replace the issue's title.")
    p_update.add_argument("--status", help='Workflow state name to move the issue to.')
    p_update.add_argument("--estimate", type=int, help="Size estimate (XS=1, S=2, M=3, L=5, XL=8).")
    p_update.add_argument(
        "--add-label",
        action="append",
        metavar="NAME",
        help="Label name to add (repeatable). Existing labels are preserved.",
    )
    p_update.add_argument(
        "--remove-label",
        action="append",
        metavar="NAME",
        help="Label name to remove (repeatable).",
    )
    p_update.add_argument("--description", help="Replace the issue's full description (markdown).")
    p_update.add_argument(
        "--append-description",
        metavar="TEXT",
        help=(
            "Append TEXT to the issue's existing description (markdown), separated "
            "by a blank line. Mutually exclusive with --description."
        ),
    )
    p_update.set_defaults(func=cmd_update_issue)

    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
